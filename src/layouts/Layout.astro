---
import "../styles/global.css";

const pages = [
  { href: "/", label: "Accueil" },
  { href: "/accessibilite", label: "Accessibilité" },
  { href: "/leaflet", label: "Leaflet" },
  { href: "/geojson", label: "GeoJSON (serveur)" },
  { href: "/geojson-client", label: "GeoJSON (client)" },
];

const chemin = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>TP7 — Cartes et graphiques</title>
  </head>
  <body>
    <header class="border-b border-gray-200 bg-white">
      <nav aria-label="Navigation principale" class="mx-auto max-w-6xl px-6">
        <ul class="flex flex-wrap gap-2 py-3">
          {
            pages.map((page) => (
              <li>
                <a
                  href={page.href}
                  aria-current={chemin === page.href ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-4 py-2 text-sm font-medium",
                    chemin === page.href
                      ? "bg-blue-600 text-white"
                      : "text-gray-700 hover:bg-gray-100",
                  ]}
                >
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
