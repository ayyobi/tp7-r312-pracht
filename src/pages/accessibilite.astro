---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

import penguins from "../assets/penguins.json";
---

<Layout>
  <main class="p-8 max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">TP7 — Accessibilité des graphiques</h1>

    <p class="mb-6">
      Visualisation des données des manchots avec Observable Plot.
    </p>

    <section aria-label="Analyse des manchots">
      <PlotFigure
        options={{
          title: "Longueur et profondeur du bec des manchots",

          subtitle: "Comparaison des mesures selon les espèces.",

          caption:
            "Chaque point représente un manchot. Les couleurs distinguent les espèces.",

          ariaLabel:
            "Nuage de points représentant la longueur et la profondeur du bec des manchots, selon leur espèce.",

          x: {
            label: "Longueur du bec (mm)",
          },

          y: {
            label: "Profondeur du bec (mm)",
          },

          color: {
            legend: true,
          },

          marks: [
            Plot.frame(),

            Plot.dot(penguins, {
              x: "culmen_length_mm",
              y: "culmen_depth_mm",
              stroke: "species",
              r: 4,
            }),
          ],
        }}
      />
    </section>
  </main>
</Layout>
